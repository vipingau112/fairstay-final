<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <h1 class="col-6 offset-3 mb-3 fw-bold">Verify your email</h1>
    <div class="col-6 offset-3">
        <p class="text-secondary small mb-3">
            We've sent a 6-digit code to <strong><%= currUser.email %></strong>. Enter it below to verify your account.
        </p>

        <form action="/verify-otp" method="POST" novalidate>
            <div class="mb-3">
                <label for="otp" class="form-label">6-digit code</label>
                <input name="otp" id="otp" type="text" inputmode="numeric" pattern="[0-9]{6}" maxlength="6"
                    class="form-control text-center" style="letter-spacing: 8px; font-size: 1.4rem; font-weight: 600;"
                    autocomplete="one-time-code" required autofocus />
            </div>

            <button class="btn btn-royal px-4 py-2">Verify</button>
        </form>

        <form action="/resend-verification-email" method="POST" class="mt-3">
            <button class="btn btn-link p-0 small">Didn't get a code? Resend it</button>
        </form>

        <p class="mt-3 small text-secondary"><a href="/listings">Skip for now</a> — you can verify later.</p>
    </div>
</div>
