<% layout("/layouts/boilerplate") %>

  <div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4">My Trips</h2>

    <% const statusColors={ pending: "warning" , confirmed: "success" , cancelled: "secondary" }; %>

      <% if (bookings.length===0) { %>
        <p class="text-muted">You haven't booked any trips yet. <a href="/listings">Explore listings</a>.</p>
        <% } %>

          <div class="row g-3">
            <% for (let booking of bookings) { %>
              <div class="col-md-6 col-12">
                <a href="/bookings/<%= booking._id %>" class="text-decoration-none text-dark">
                  <div class="card border-0 rounded-4 shadow-sm p-3 h-100">
                    <div class="d-flex gap-3">
                      <img src="<%= booking.listing.image.url %>" class="rounded-3 object-fit-cover"
                        style="width: 90px; height: 80px;" alt="listing">
                      <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start">
                          <h6 class="fw-bold mb-1">
                            <%= booking.listing.title %>
                          </h6>
                          <span class="badge bg-<%= statusColors[booking.status] %> text-uppercase small">
                            <%= booking.status %>
                          </span>
                        </div>
                        <p class="text-secondary small mb-1">
                          <%= booking.checkIn.toDateString() %> &rarr; <%= booking.checkOut.toDateString() %>
                        </p>
                        <% if (booking.roomNumber) { %>
                          <p class="text-secondary small mb-1"><i class="bi bi-door-closed-fill me-1"></i>Room <%=
                              booking.roomNumber %>
                          </p>
                          <% } %>
                            <p class="fw-medium small mb-0">&#8377;<%= booking.totalPrice.toLocaleString("en-IN") %>
                            </p>
                      </div>
                    </div>
                  </div>
                </a>
              </div>
              <% } %>
          </div>
  </div>