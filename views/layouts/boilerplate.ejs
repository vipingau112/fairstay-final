<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FairStay - Find Your Next Safe Haven</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@v5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/style.css">
</head>

<body class="d-flex flex-column min-vh-100">
    <%- include("../includes/navbar.ejs") %>

        <div class="container flex-grow-1 px-md-5 mt-3">
            <% if(success && success.length) { %>
                <div class="alert alert-success alert-dismissible fade show col-6 offset-3 border-0 rounded-3 py-2 px-3 mb-4"
                    role="alert" style="background-color: #d1e7dd; color: #0f5132;">
                    <%= success %>
                        <button type="button" class="btn-close shadow-none py-2.5" data-bs-dismiss="alert"
                            aria-label="Close" style="font-size: 0.8rem;"></button>
                </div>
                <% } %>

                    <% if(error && error.length) { %>
                        <div class="alert alert-danger alert-dismissible fade show col-6 offset-3 border-0 rounded-3 py-2 px-3 mb-4"
                            role="alert" style="background-color: #f8d7da; color: #842029;">
                            <%= error %>
                                <button type="button" class="btn-close shadow-none py-2.5" data-bs-dismiss="alert"
                                    aria-label="Close" style="font-size: 0.8rem;"></button>
                        </div>
                        <% } %>

                            <% if (currUser && !currUser.emailVerified) { %>
                                <div class="alert alert-warning col-6 offset-3 border-0 rounded-3 py-2 px-3 mb-4 d-flex justify-content-between align-items-center"
                                    role="alert">
                                    <span><i class="bi bi-envelope-exclamation-fill me-1"></i>Please verify your email
                                        address.</span>
                                    <form method="POST" action="/resend-verification-email" class="mb-0">
                                        <button class="btn btn-sm btn-outline-royal">Resend Link</button>
                                    </form>
                                </div>
                                <% } %>

                                    <%- body %>
        </div>

        <%- include("../includes/footer.ejs") %>
            <%- include("../includes/chatbot.ejs") %>

                <script src="https://cdn.jsdelivr.net/npm/bootstrap@v5.3.0/dist/js/bootstrap.bundle.min.js"></script>
                <script src="/js/script.js"></script>
</body>

</html>